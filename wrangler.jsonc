{
  "name": "orange-card-90day-calculator",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "RANKINGS_DB",
      "database_name": "hyb-card-rankings-db",
      "database_id": "671fa86c-407b-472f-9bdc-6cf8e2a9a00a"
    }
  ],
  "routes": [
    {
      "pattern": "card.gudong226.com",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "RANKINGS_WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "workers_dev": true
}
