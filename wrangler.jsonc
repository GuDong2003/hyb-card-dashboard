{
  "name": "orange-card-90day-calculator",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "RANKINGS_DB",
      "database_name": "hyb-card-rankings-db"
    }
  ],
  "routes": [
    {
      "pattern": "card.gudong226.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
