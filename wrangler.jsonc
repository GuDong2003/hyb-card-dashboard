{
  "name": "orange-card-90day-calculator",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "RANKINGS_DB",
      "database_name": "hyb-card-rankings-v2-db",
      "database_id": "457cdbe7-aac9-411f-9543-1ffb834365b4"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RANKINGS_HOME_CACHE",
      "id": "e4e066e0d472423f9391eb62ac998b90"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VISITOR_COUNTER",
        "class_name": "VisitorCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VisitorCounter"]
    }
  ],
  "routes": [
    {
      "pattern": "card.gudong226.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["5 20 * * *"]
  },
  "ratelimits": [
    {
      "name": "RANKINGS_WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "workers_dev": true
}
